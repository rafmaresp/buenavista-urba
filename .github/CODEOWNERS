# Zonas sensibles de la política de fusión (AGENTS.md, sección "Política de fusión").
# Un PR que toque cualquiera de estas rutas lo fusiona siempre Rafa: el workflow
# fusion-automatica.yml lee esta lista y no fusiona esos PRs.
#
# La revisión de code owners no está activada en el ruleset de `main`; quien aplica la lista es
# ese workflow. Algunas rutas aún no existen: se dejan para que la regla valga en cuanto aparezcan.

# La propia política y lo que controla a los agentes
/AGENTS.md                              @rafmaresp
/CLAUDE.md                              @rafmaresp
/.github/                               @rafmaresp
/.claude/                               @rafmaresp
/.specify/                              @rafmaresp
/docs/decisions/                        @rafmaresp

# Funcionalidades nuevas completas (llevan spec)
/specs/                                 @rafmaresp

# Login, roles y permisos
/api/src/**/auth*                       @rafmaresp
/api/src/**/*usuario*                   @rafmaresp
/api/src/**/*roles*                     @rafmaresp
/api/src/**/*permis*                    @rafmaresp
/web/src/app/**/*auth*                  @rafmaresp

# Modelo de datos, auditoría y datos personales (RGPD)
/api/src/**/*modelo*                    @rafmaresp
/api/src/**/*repositorio*               @rafmaresp
/api/src/lib/repo.*                     @rafmaresp
/api/src/**/*auditor*                   @rafmaresp
/api/src/**/*tables*                    @rafmaresp
/api/src/**/*storage*                   @rafmaresp
/data/                                  @rafmaresp
/docs/rgpd/                             @rafmaresp

# Capa restringida de redes (tuberías y cables)
**/*redes*                              @rafmaresp

# Infraestructura, configuración de despliegue y seguridad del front
/infra/                                 @rafmaresp
/api/host.json                          @rafmaresp
/web/public/staticwebapp.config.json    @rafmaresp

# Lo que fija los guardarraíles de la CI (umbral de cobertura, configuración de tests y de
# escáneres). Los `scripts` de cada package.json los vigila fusion-lib.mjs.
/quality.config.json                    @rafmaresp
/.semgrepignore                         @rafmaresp
/.trivyignore                           @rafmaresp
/api/vitest.config.*                    @rafmaresp
/web/vitest.config.*                    @rafmaresp
/web/angular.json                       @rafmaresp
/web/tsconfig.spec.json                 @rafmaresp
/e2e/playwright.config.*                @rafmaresp
